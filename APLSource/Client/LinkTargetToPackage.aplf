 {r}←LinkTargetToPackage(cfg source target alias);ref;name;nc;ref2
⍝ Establishes a reference in the target space pointing to the loaded package.\\
⍝ Returns the fully qualified names of what was established in the target space.
 r←⍬
 ref←⍎source
 :If 0=≢alias
     name←cfg.name
 :Else
     name←alias
 :EndIf
 :If 0<≢cfg.api
     ('Not found in ',source,': ',cfg.api)Assert 0<⍎source,'.⎕NC ''',cfg.api,''''
     ('Is neither class nor namespace: ',cfg.api)Assert 9=⍎source,'.⎕NC ''',cfg.api,''''
     nc←(⍎target).⎕NC⊂name
     :If nc∊9.4 9.5 9.1
         ref2←⍎target,'.',name
         :If ~∨/'._tatin.'⍷⍕ref2  ⍝ We allow overwriting a ref pointing to a package
             ('<',target,'.',name,'> exists but is neither a package nor empty')Assert 0=≢ref2.⎕NL⍳16
             'Cannot load package into a script'Assert~##.APLTreeUtils2.IsScripted ref2
         :EndIf
     :Else
         ⍝ Otherwise the name must not be used:
         ('<',target,'.',name,'> is already defined as an object with name class ',⍕nc)Assert 0=nc
     :EndIf
     target⍎name,'←',source,'.',cfg.api
 :Else
     target⍎name,'←',source
 :EndIf
 r,←target,'.',name
⍝Done
