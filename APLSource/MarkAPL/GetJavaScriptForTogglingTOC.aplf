 r←GetJavaScriptForTogglingTOC parms
 r←''
 r,←⊂''
 r,←⊂'// Show/Hide the TOC. It starts in normal flow (open); once toggled it becomes'
 r,←⊂'// an out-of-flow overlay (`.floating`) so further toggles do not re-composite'
 r,←⊂'// the whole page (which made the mouse erratic on large documents). Driven by'
 r,←⊂'// an inline style, so it also works when the stylesheet did not load.'
 r,←⊂'(function () {'
 r,←⊂'  var button = document.querySelector("#toc-toggle");'
 r,←⊂'  var content = document.querySelector("#toc-list");'
 r,←⊂'  if (!button || !content) { return; }'
 r,←⊂'  var open = !content.classList.contains("hide");'
 r,←⊂'  content.classList.remove("hide");'
 r,←⊂'  function setLabel(state) {'
 r,←⊂'    button.innerText = state ? "',parms.tocHideCaption,'" : "',parms.tocShowCaption,'";'
 r,←⊂'    button.setAttribute("aria-expanded", state);'
 r,←⊂'  }'
 r,←⊂'  function setOpen(state) {'
 r,←⊂'    content.classList.add("floating");   // out-of-flow overlay: cheap to toggle'
 r,←⊂'    content.style.display = state ? "block" : "none";'
 r,←⊂'    setLabel(state);'
 r,←⊂'  }'
 r,←⊂'  if (open) { setLabel(true); } else { setOpen(false); }   // leave it in flow on load'
 r,←⊂'  button.addEventListener("click", function () {'
 r,←⊂'    setOpen(content.style.display === "none");'
 r,←⊂'  });'
 r,←⊂'  content.addEventListener("click", function (evt) {'
 r,←⊂'    if (evt.target.closest("a")) { setOpen(false); }   // close after picking an entry'
 r,←⊂'  });'
 r,←⊂'})();'
 r,←⊂''
