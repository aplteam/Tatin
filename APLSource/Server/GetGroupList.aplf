 response←GetGroupList dummy;data;html;groups;path;published;parms;mat
 path←'expand'F.NormalizePath G.RegistryPath
 :If IsJsonRequest request.Headers
     data←Reg.ListGroups path
     response←request ReturnJSON Reg.JSON data
 :Else
     published←∪GetGroupList_ path                  ⍝ Groups with anything published, deprecated or not
     groups←∪published,G.Credentials[;1]~,⊂,'*'   ⍝ Plus those known from the credentials only
     groups←groups[⍋⎕C groups]
     parms←Reg.CheckParmsForListPackages ⍬
     parms.date←0
     mat←GetPackageList_ parms
     html←PrepareHtmlPageForGroupList groups published mat
     response←request ReturnHTML html
 :EndIf
⍝Done
