 response←GetServerVersion request;data;html
⍝ Respond to a request for the version of Tatin the server runs, HTML or JSON
 :If IsJsonRequest request.Headers
     data←Reg.Version
     response←request ReturnJSON Reg.JSON data
 :Else
     html←PrepareHtmlPageForVersionInformation ⍬
     response←request ReturnHTML html
 :EndIf
