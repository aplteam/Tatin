 html←PrepareHTMLforAllSpecialCommands dummy
 html←(1 'Special REST commands' '')HtmlHeader''
 html,←⊂'<div class="page-head">'
 html,←⊂'<h2>All special REST commands</h2>'
 html,←⊂'<p class="intro">These special commands are available on test servers only: they are for testing Tatin.</p>'
 html,←⊂'</div>'
 html,←⊂'<h3>GET commands</h3>'
 html,←⊂'<ul>'
 html,←H.LI¨GetSpecialCommands'GET'
 html,←⊂'</ul>'
 html,←⊂'<h3>PUT commands</h3>'
 html,←⊂'<ul>'
 html,←H.LI¨GetSpecialCommands'PUT'
 html,←⊂'</ul>'
 html,←⊆GetFooter
 html,←⊂'</body>'
 html,←⊂'</html>'
 html←⊃,/CR,¨html
⍝Done
