 html←PrepareHtmlPageForDeprecatedList list;majors
⍝ Returns the page listing the deprecated major versions, one row each.
⍝ `list` holds package IDs. Only their major version lines matter here, so a request asking for
⍝ "all" versions gets the same page; that makes a difference for JSON only.
 majors←∪Reg.RemoveMinorAndPatch¨list
 html←(⍬'Deprecated packages' '/deprecated-pkgs')HtmlHeader''
 html,←⊂'<div class="page-head">'
 html,←⊂'<h2>Deprecated packages <span class="page-sub">',(⍕≢majors),'</span></h2>'
 html,←⊂'</div>'
 :If 0=≢majors
     html,←⊂'<p class="no-match">No package is deprecated.</p>'
 :Else
     html,←⊂'<div class="deprecated-list">'
     html,←PrepareHtmlPageForDeprecatedList_¨majors
     html,←⊂'</div>'
 :EndIf
 html,←⊆GetFooter
 html,←⊂'</body>'
 html,←⊂'</html>'
⍝Done
