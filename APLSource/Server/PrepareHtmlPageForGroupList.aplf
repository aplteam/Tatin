 html←PrepareHtmlPageForGroupList(groups published mat);packageGroups;group;bool;noOf;label
⍝ Returns the page listing all groups, each with its packages.
⍝ `groups` is a vector of group names: those with packages and those known from the credentials
⍝ only. `published` names the groups that have published anything, deprecated or not. `mat`
⍝ comes from `GetPackageList_`, one row per package that is not deprecated.
⍝ A group name leads to the group's home page when it has one, otherwise to the list of its
⍝ packages (see `GetGroupHref`); a package name leads to the page of its latest major version.
 html←(⍬'Groups' '/groups')HtmlHeader''
 html,←⊂'<div class="page-head">'
 html,←⊂'<h2>Groups <span class="page-sub">',(⍕≢groups),'</span></h2>'
 html,←⊂'<p class="intro">A group is the part of a package ID in front of the first hyphen: <code>aplteam-Cider</code> belongs to <code>aplteam</code>. A group name leads to the group''s home page if it has one, otherwise to its packages.</p>'
 html,←⊂'</div>'
 html,←⊂'<div class="group-grid">'
 packageGroups←{⍵↑⍨¯1+⍵⍳'-'}¨mat[;1]              ⍝ The group is what comes before the first hyphen
 :For group :In groups
     bool←packageGroups≡¨⊂group
     noOf←+/bool
     :If 0<noOf
         label←(⍕noOf),' package',(1≠noOf)/'s'
     :ElseIf (⊂group)∊published
         label←'only deprecated packages'
     :Else
         label←'no packages yet'
     :EndIf
     html,←⊂'<section class="group-card">'
     html,←⊂'<div class="group-card-head"><a href="',(EscapeAttributeValue GetGroupHref group),'">',(EscapeSpecialChars group),'</a><span>',label,'</span></div>'
     :If 0<noOf
         html,←⊂'<div class="group-card-packages">',(⊃,/(1+≢group)PrepareHtmlPageForGroupList_¨↓bool⌿mat[;1 8]),'</div>'
     :EndIf
     html,←⊂'</section>'
 :EndFor
 html,←⊂'</div>'
 html,←⊆GetFooter
 html,←⊂'</body>'
 html,←⊂'</html>'
⍝Done
