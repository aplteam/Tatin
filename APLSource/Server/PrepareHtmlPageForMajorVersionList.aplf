 html←PrepareHtmlPageForMajorVersionList(packageID data);colTitles
⍝ Not indexed: this page is a list of links and has no content of its own, nor any prospect
⍝ of any. A crawler is still welcome to follow the links out of it - "noindex" alone leaves
⍝ "follow" at its default - and a visitor sees no difference.
 html←(1 packageID)HtmlHeader ''
 html,←⊂'<h2>Major versions of "',packageID,'"</h2>'
 html,←AddSpecialMessage ⍬
 colTitles←'Package name' 'Major version' 'Number of<br>minor versions'
 html,←⊂H.OpenTable colTitles CalcTableWidth data
 html,←⊂'<thead>'
 html,←⊂'<tr class="my-first-th">'
 html,←{'<th>',⍵,'</th>'}¨colTitles
 html,←⊂'</tr>'
 html,←⊂'</thead>'
 html,←⊂'<tbody>'
 html,←{'<tr><td><a href="',Reg.VersionOf_REST,'/packages/versions/',(1⊃⍵),'-',(2⊃⍵),'" title="List all versions"><code>',(1⊃⍵),'</code></a></td><td>',(2⊃⍵),'</td><td style="text-align:end">',(⍕3⊃⍵),'</td></tr>'}¨↓data
 html,←⊂'</tbody>'
 html,←⊂'</table>'
 html,←⊆GetFooter
 html,←⊂'</body>'
 html,←⊂'</html>'
⍝Done
