 html←PrepareHtmlPageForPackageList_ row;name;majors;description;os;uc;tags;latestMajor;group;tagList;majorsLabel
⍝ Returns the markup of one row of the list of packages; see `PrepareHtmlPageForPackageList`.
⍝ `row` is one row of what `GetPackageList_` returns. The project URL is not used: that link
⍝ lives on the package page.
⍝ The name leads to the package page of the latest major version, "2 majors" to the list of
⍝ all major versions, and every tag back to this list, filtered by that tag.
 (name majors description os uc tags latestMajor)←row[1 2 3 5 6 7 8]
 group←name↑⍨name⍳'-'                               ⍝ Including the hyphen
 tagList←','(≠⊆⊢)'\s*[,;]\s*'⎕R','⊣tags
 html←'<div class="pkg-row" data-name="',(EscapeAttributeValue name),'" data-desc="',(EscapeAttributeValue description)
 html,←'" data-tags="',(EscapeAttributeValue{0=≢⍵:'' ⋄ 1↓⊃,/' ',¨⍵}tagList),'" data-majors="',(⍕majors),'">'
 html,←'<a class="pkg-name" href="',Reg.VersionOf_REST,'/packages/versions/',latestMajor,'">'
 html,←'<span class="pkg-group-prefix">',(EscapeSpecialChars group),'</span>',(EscapeSpecialChars(≢group)↓name),'</a>'
 html,←'<div class="pkg-desc"><span>',(EscapeSpecialChars description),'</span>'
 :If 0<≢tagList
     html,←'<span class="pkg-tags">',(⊃,/{'<a href="',Reg.VersionOf_REST,'/packages?tag=',(EscapeAttributeValue ⍵),'">',(EscapeSpecialChars ⍵),'</a>'}¨tagList),'</span>'
 :EndIf
 html,←'</div>'
 html,←'<span class="pkg-os" title="Runs on">',(⊃,/{'<span',((⍵∊os)/' class="os-on"'),'>',⍵,'</span>'}¨'LMW'),'</span>'
 :If 0<≢uc
     html,←'<span class="pkg-uc"><span class="uc-flag uc-yes" title="Is a user command"></span><span class="sr-only">user command</span></span>'
 :Else
     html,←'<span class="pkg-uc"></span>'
 :EndIf
 majorsLabel←(⍕majors),' major',(1≠majors)/'s'
 :If 1<majors
     html,←'<span class="pkg-majors"><a href="',Reg.VersionOf_REST,'/packages/major_versions/',name,'">',majorsLabel,'</a></span>'
 :Else
     html,←'<span class="pkg-majors">',majorsLabel,'</span>'
 :EndIf
 html,←'</div>'
⍝Done
