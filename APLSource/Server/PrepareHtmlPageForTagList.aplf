 html←PrepareHtmlPageForTagList data;colTitles
 html←(⍬'List of all tags')HtmlHeader GetDataTableStuff ⍬
 html,←⊂'<h2>List of all tags</h2>'
 html,←AddSpecialMessage ⍬
 colTitles←'Tag' 'Occurrences'
 data[;2]←⍕¨data[;2]
 html,←⊂H.OpenTable colTitles CalcTableWidth data
 html,←⊂'<thead>'
 html,←⊂'<tr class="my-first-th">'
 html,←{'<th>',⍵,'</th>'}¨colTitles
 html,←⊂'</tr>'
 html,←⊂'</thead>'
 html,←⊂'<tbody>'
 html,←⊃¨{'<tr><td>',⍺,'</td><td>',⍵,'</td></tr>'}/¨↓data
 html,←⊂'</tbody>'
 html,←⊂'</table>'
 html,←⊆GetFooter
 html,←⊂'</body>'
 html,←⊂'</html>'
 ⍝Done
