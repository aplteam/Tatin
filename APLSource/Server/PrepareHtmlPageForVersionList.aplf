 html←PrepareHtmlPageForVersionList(packageID data);links;col1;col2;col3;col4;bool;colTitles;newestPath;description
 data←⊖data
⍝ The README and the description belong to the newest release of this major version line:
⍝ that is the only one a README is ever fetched for. The newest is picked by date rather
⍝ than by position, so it does not matter which way round `data` happens to be sorted.
 newestPath←G.RegistryPath,'/',⊃data[(⊃⌽⍋data[;2]);1]
 description←GetPackageDescription newestPath     ⍝ Wanted twice: in the head and on the page
 html←(⍬ packageID)HtmlHeader(GetMetaDescription description),GetJavaScriptForCopyButton ⍬
 html,←⊂'<h2>All versions of "',packageID,'"</h2>'
 html,←AddSpecialMessage ⍬
⍝ The box floats, so it goes before the description it sits beside.
 html,←GetInstallInfo packageID(≢data)
 :If 0<≢description
     html,←⊂'<p class="pkg-description">',(EscapeSpecialChars description),'</p>'
 :EndIf
⍝ Before the table on purpose: the documentation is what this page is about, and what a
⍝ search engine should find first. The table of releases stays underneath it.
 html,←GetReadmeSection newestPath
 colTitles←'Package ID' 'Publishing date' 'Config' 'Dependencies'
 html,←⊂'<section id="releases">'
 html,←⊂H.OpenTable colTitles CalcTableWidth data
 html,←⊂'<thead>'
 html,←⊂'<tr class="my-first-th">'
 html,←{'<th>',⍵,'</th>'}¨colTitles
 html,←⊂'</tr>'
 html,←⊂'</thead>'
 html,←⊂'<tbody>'
 col1←{'<td><code>',⍵,'</code></td>'}¨data[;1]         ⍝ The package ID
 col2←{'<td>',(⍕⍵),'</td>'}¨data[;2]                   ⍝ The publishing Date
 links←{'<a href="',Reg.VersionOf_REST,'/packages/details/',⍵,'" title="Link to the package configuration">Show</a>'}¨data[;1]
 col3←{'<td>',⍵,'</td>'}¨links
 bool←PackageHasDependencies¨data[;1]
 links←bool{⍺:'<a href="',Reg.VersionOf_REST,'/packages/dependencies/',⍵,'" title="Link to the dependency definition">Show</a>' ⋄ 'None'}¨data[;1]
 col4←{'<td>',⍵,'</td>'}¨links
 html,←{'<tr>',⍵,'</tr>'}¨col1,¨col2,¨col3,¨col4
 html,←⊂'</tr>'
 html,←⊂'</tbody>'
 html,←⊂'</table>'
 html,←⊂'</section>'
 html,←⊆GetFooter
 html,←⊂'</body>'
 html,←⊂'</html>'
⍝Done
