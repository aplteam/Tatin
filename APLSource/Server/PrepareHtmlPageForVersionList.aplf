 html←PrepareHtmlPageForVersionList(packageID data);newestPath;cfg;description;deprecated;majorLine;parts;group;name;title;caption;head;menuItem;crumbs;readme;tags;tagList
⍝ The package page: the releases of one major version of a package, or of all its major
⍝ versions when the request named none.
⍝ `data` holds one row per release: [;1] package ID, [;2] publishing date.
⍝ Everything the page says about the package - description, key facts, ReadMe and tags - comes
⍝ from the newest release: that is the only one a ReadMe is ever fetched for.
⍝ "Newest" means what it means everywhere in Tatin: `Reg.ListVersions` sorts by version number
⍝ and only where that cannot decide, as with betas, by publishing date. The best release comes
⍝ last there, so after the ⊖ it is the first row.
⍝ A deprecated package gets a band that says so, and no install command: nobody should be
⍝ invited to install it. The menu then marks "Deprecated" rather than "Packages".
 data←⊖data
 newestPath←G.RegistryPath,'/',⊃data[1;1]
 cfg←ReadPackageConfig newestPath
 description←'' GetConfigValue cfg'description'     ⍝ Wanted twice: in the head and on the page
 deprecated←1≡0 GetConfigValue cfg'deprecated'
 majorLine←Reg.RemoveMinorAndPatch packageID
 parts←'-'(≠⊆⊢)majorLine
 (group name)←2↑parts
 :If 3=≢parts                                       ⍝ Group, name and major version
     title←'major version ',3⊃parts
     caption←'in major version ',3⊃parts
 :Else
     title←'all major versions'
     caption←'in all major versions'
 :EndIf
 head←GetMetaDescription description
 head,←⊂'<script src="/Assets/JS/package-page.js" defer></script>'
 :If deprecated
     menuItem←'/deprecated-pkgs'
     crumbs←⊂'Deprecated'(Reg.VersionOf_REST,'/deprecated-pkgs')
 :Else
     menuItem←'/packages'
     crumbs←⊂'Packages'(Reg.VersionOf_REST,'/packages')
     head,←GetJavaScriptForCopyButton ⍬
 :EndIf
 crumbs,←(⊂group(GetGroupHref group)),⊂name''
 html←(⍬ packageID menuItem)HtmlHeader head
 html,←⊂'<div class="page-head',(deprecated/' is-deprecated'),'">'
 html,←⊂GetBreadcrumb crumbs
 html,←⊂'<h2>',(EscapeSpecialChars name),' <span class="page-sub">',title,'</span></h2>'
 :If 0<≢description
     html,←⊂'<p class="lead">',(EscapeSpecialChars description),'</p>'
 :EndIf
 html,←⊂'</div>'
 :If deprecated
     html,←GetDeprecatedBand('' GetConfigValue cfg'deprecateComment')
 :EndIf
 html,←GetPackageFacts cfg
 :If ~deprecated
     html,←GetInstallInfo majorLine
 :EndIf
⍝ Without a ReadMe the releases move over into its place rather than leave a hole there
 readme←GetReadmeSection newestPath
 html,←⊂'<div class="pkg-body',((0=≢readme)/' no-readme'),'">'
 html,←readme
 html,←⊂'<aside class="pkg-aside">'
 html,←GetReleaseList data caption
 tags←'' GetConfigValue cfg'tags'
 tagList←','(≠⊆⊢)'\s*[,;]\s*'⎕R','⊣tags
 :If 0<≢tagList
     html,←⊂'<section class="pkg-tag-list">'
     html,←⊂'<h3>Tags</h3>'
     html,←⊂'<p>',(⊃,/{'<a href="',Reg.VersionOf_REST,'/packages?tag=',(EscapeAttributeValue ⍵),'">',(EscapeSpecialChars ⍵),'</a>'}¨tagList),'</p>'
     html,←⊂'</section>'
 :EndIf
 html,←⊂'</aside>'
 html,←⊂'</div>'
 html,←⊆GetFooter
 html,←⊂'</body>'
 html,←⊂'</html>'
⍝Done
