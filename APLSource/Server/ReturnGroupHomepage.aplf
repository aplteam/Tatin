 response←ReturnGroupHomepage(groupName request);html;htmlFilename;folder;email;data;noOf;action;caption
⍝ Returns the home page of a group: what the group's owner wrote about it, whom to contact and
⍝ the group's packages. A group without a home page gets the offer to create one.
⍝ Creating or editing needs the group's API key; see `EditGroupHomepage_`.
 response←R.NewResponse request
 folder←G.HTDOCS,'../Groups/'
 'Create!'F.CheckPath folder
 htmlFilename←folder,groupName,'.htm'
 data←GetPackagesOfGroup groupName
 noOf←≢data
 html←(⍬('Group ',groupName)'/groups')HtmlHeader''
 html,←⊂'<div class="page-head">'
 html,←⊂GetBreadcrumb('Groups'(Reg.VersionOf_REST,'/groups'))(groupName'')
 html,←⊂'<h2>',(EscapeSpecialChars groupName),' <span class="page-sub">',(⍕noOf),' package',((1≠noOf)/'s'),'</span></h2>'
 html,←⊂'</div>'
 html,←⊂'<div class="group-home">'
 :If F.IsFile htmlFilename
     html,←⊂'<article class="prose">'
     html,←⊂⊃⎕NGET htmlFilename
     html,←⊂'</article>'
     email←'email'Reg.GetGroupData G.RegistryPath groupName
     action←'group-homepage-edit'
     caption←'Edit this home page'
 :Else
     html,←⊂'<p class="no-match">There is no home page yet for the group "',(EscapeSpecialChars groupName),'".</p>'
     email←''
     action←'group-homepage-create'
     caption←'Create a home page'
 :EndIf
 html,←⊂'<aside class="group-home-side">'
 :If 0<≢email
     html,←⊂'<div class="side-fact"><span>Contact</span><a href="mailto:',(EscapeAttributeValue email),'">',(EscapeSpecialChars email),'</a></div>'
 :EndIf
⍝ The button submits the group's name, which is what the edit and the create page ask for
 html,←⊂'<form action="',action,'"><button type="submit" name="name" value="',(EscapeAttributeValue groupName),'" class="button button-outline">',caption,'</button></form>'
 :If 0<≢G.Credentials
     html,←⊂'<p class="side-note">This needs the group''s API key.</p>'
 :EndIf
 html,←⊂'</aside>'
 html,←⊂'</div>'
 :If 0<noOf
     html,←⊂'<div class="group-packages-head"><h3>Packages</h3>'
     html,←⊂'<p class="legend"><span><b>L</b>Linux</span><span><b>M</b>macOS</span><span><b>W</b>Windows</span><span><span class="uc-flag uc-yes" aria-hidden="true"></span>user command</span></p>'
     html,←⊂'</div>'
     html,←⊂'<div class="pkg-list"><div class="pkg-rows">'
     html,←PrepareHtmlPageForPackageList_¨↓data
     html,←⊂'</div></div>'
 :EndIf
 html,←⊆GetFooter
 html,←⊂'</body>'
 html,←⊂'</html>'
 response←request ReturnHTML html
⍝Done
