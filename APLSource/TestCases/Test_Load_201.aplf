 r←Test_Load_201(stopFlag batchFlag);⎕TRAP;msg;rc;qdmx;noOf
⍝ Loads package APLTreeUtils2 into #.Foo and then again a later version of that package
⍝ We allow overwriting packages, so that must work
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')
 r←T._Failed

 #.⎕SHADOW'Foo' ⋄ 'Foo'#.⎕NS''
 noOf←⎕SE.Tatin.LoadPackages(##.CiderConfig.HOME,'/TestData\aplteam-APLTreeUtils2-1.1.1.zip')'#.Foo'
 Assert noOf=1
 →T.PassesIf '1.1.1'≡{⍵↑⍨¯1+⍵⍳'+'}2⊃#.Foo.APLTreeUtils2.Version

 noOf←⎕SE.Tatin.LoadPackages(##.CiderConfig.HOME,'/TestData\aplteam-APLTreeUtils2-1.4.1.zip')'#.Foo'
 Assert noOf=1
 →T.PassesIf '1.4.1'≡{⍵↑⍨¯1+⍵⍳'+'}2⊃#.Foo.APLTreeUtils2.Version

 r←T._OK
⍝Done
