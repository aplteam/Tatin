 r←Test_Server_421(stopFlag batchFlag);⎕TRAP;html
⍝ Ask for the credential report; pretends to be a Browser
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')
 r←T._Failed

 html←∆GetHtmlFromServer'[localhost]/v1/credential-report'
 →T.PassesIf∨/'<h2>Credential report</h2>'⍷html
 →T.PassesIf∨/'<div class="report">'⍷html

 r←T._OK
⍝Done
