 r←Cache Arg;url;list;pathFlag;flag;report;rc;buff
 r←''
 :If 0≡Arg._1
     url←''
 :Else
     url←Arg._1
 :EndIf
 :If Arg.path
 :OrIf Arg.clear
     pathFlag←1
 :Else
     pathFlag←0
 :EndIf
 :If 0<≢list←pathFlag TC.ListCache url
     :If Arg.clear
         buff←⎕FMT⍪{⍪('--- Entries in cache for ',(1⊃⍵),':')(⍪2⊃⍵)}¨list
     :Else
         buff←⎕FMT⍪{⍪('--- Entries in cache for ',(1⊃⍵),':')(⍪2⊃⍵)}¨list
     :EndIf
 :Else
     ⍞←'Nothing found in ',TC.GetPathToPackageCache,⎕UCS 10
 :EndIf
 :If 0<≢list
 :AndIf Arg.clear
     :If Arg.force
         flag←1
     :Else
         ⍞←buff
         ⍞←⎕UCS 10
         flag←TC.C.YesOrNo'Sure that you want delete these from the Tatin package cache?'
     :EndIf
 :AndIf flag
     (rc report)←TC.ClearCache url
     :If 0=rc
         ⍞←'Cache successfully cleared',⎕UCS 10
     :Else
         ⍞←'Attempt to delete these failed:'(,⊃,/CR¨,⊆report),⎕UCS 10
     :EndIf
 :EndIf
