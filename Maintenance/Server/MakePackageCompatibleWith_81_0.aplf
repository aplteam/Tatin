  {cfg}←pkgID MakePackageCompatibleWith_81_0 (cfg regPath);tags;groupName;pkgName
⍝ 2022-12-07
 pkgName←{⍵↑⍨¯1+⍵⍳'-'}{⍵↓⍨⍵⍳'-'}pkgID
 groupName←{⍵↑⍨¯1+⍵⍳'-'}pkgID

 cfg.⎕EX'wx'       ⍝ Delete outdated stuff

 :If 0<cfg.⎕NC'comment'
     deprecate_comment←cfg.comment
     cfg.⎕EX'comment '
 :EndIf

 :If 0=cfg.⎕NC'minimumAplVersion'
 :OrIf 0=≢cfg.minimumAplVersion
     cfg.minimumAplVersion←'18.2'
 :EndIf

 :If 0=cfg.⎕NC'tags'
     cfg.tags←''
 :EndIf
 tags←{','@(⍸';'=⍵)⊢⍵}cfg.tags
 tags←','(≠⊆⊢)tags
 tags~←'apl' 'dyalog' 'dyalog-apl' 'dyalogapl'   ⍝ Tatin is a Dyalog APL package manager...
 :If 0=cfg.⎕NC'os_win'
     cfg.os_win←(⊂'windows')∊tags
     cfg.os_mac←∨/'mac-os' 'mac' 'macos'∊tags
     cfg.os_lin←(⊂'linux')∊tags
     :If 0=+/cfg.(os_win os_mac os_lin)
         :If (⊂pkgName)∊'Execute' 'Laguntza' 'WinReg'
             cfg.os_win←1
         :ElseIf (⊂pkgName)∊'APLGit' 'GitHubAPIv3' 'SevenZip'
             cfg.(os_win os_mac os_lin)←1
         :EndIf
     :EndIf
 :EndIf

 tags~←'windows' 'mac-os' 'macos' 'mac' 'linux'
 tags~←'apltree'groupName          ⍝ apltree does not offer much, and the group name should never be a tag
 cfg.tags←{0=≢⍵:⍵ ⋄ ⊃{⍺,',',⍵}/⍵}tags
 :If 0=≢cfg.tags
     cfg.tags←''
     :If 'APLTreeUtils2'≡pkgName
         cfg.tags←'utilities'
     :Else
         ⍝∘∘∘
     :EndIf
 :EndIf

 :If 0=cfg.⎕NC'maintainer'
 :OrIf 0=≢cfg.maintainer
     :Select {⍵↑⍨¯1+⍵⍳'-'}pkgID
     :Case 'aplteam'
         cfg.maintainer←'kai@aplteam.com'
     :Case 'davin'
         cfg.maintainer←'davinchurch@gmail.com '
     :Case 'dyalog'
         cfg.maintainer←'support@dyalog.com'
     :EndSelect
 :EndIf

 :If 'dyalog-Jarvis'≡##.##.Registry.RemoveVersionNumber pkgID
     cfg.info_url←'https://github.com/Dyalog/Jarvis'
 :EndIf
⍝Done